#!/bin/bash
set -ue

me="$(realpath $0)"
myname="$(basename ${me})"
mydir="$(dirname ${me})"
mypid="$$"

piddir="${XDG_RUNTIME_DIR}/@NAME@"
pidfile="${piddir}/${DISPLAY}"

__inotifywait=$(which inotifywait)
__notify_send=$(which notify-send)

updates_txt=${DNF_CHECK_UPDATE_DAEMON_TXT:-@updates_txt@}

function notify_user() {
    if
        [[ -s "${updates_txt}" ]]
    then
        ${__notify_send} -u normal -t 5000 -i dialog-warning "Updates available:" "$(<${updates_txt})"
    fi
}


function _write_pidfile() {
    mkdir -p ${piddir}
    ps -p ${mypid} -opid= -oargs= > ${pidfile}
}

function _read_pidfile() {
    if
        [[ -e ${pidfile} ]]
    then
        local _pid _args
        read _pid _args < ${pidfile}
        if
            [[ $(ps -p ${_pid} -oargs=) == ${_args} ]]
        then
            echo ${_pid}
        else
            rm ${pidfile} >&2
        fi
    fi
}

function _status() {
    local _pid=$(_read_pidfile)
    if
        [[ -z ${_pid} ]]
    then
        echo "User script '${myname}' is not running"
    else
        echo "User script '${myname}' is running with pid [${_pid}]"
        echo "pidfile: '${pidfile}'"
        echo "Monitoring '${updates_txt}' for changes"
    fi
    if
        [[ -s "${updates_txt}" ]]
    then
        echo "Updates available:"
        cat "${updates_txt}"
    fi
}

function _start() {
    if
        [[ -z $(_read_pidfile) ]]
    then
        _write_pidfile
        trap "rm ${pidfile}; pkill -P ${mypid}" EXIT
        while
            true
        do
            notify_user
            ${__inotifywait} -qq -e close_write ${updates_txt}
        done
    fi
}

function _stop() {
    local _pid=$(_read_pidfile)
    [[ -n ${_pid} ]] && kill ${_pid}
}

function _settings() {
    local _autostart=
    local xdg_autostart_dir="${XDG_CONFIG_HOME:-${HOME}/.config/autostart}"
    [[ -d "${xdg_autostart_dir}" ]] || return
    local _desktopfile="${xdg_autostart_dir}/@NAME@.desktop"
    echo "Autostart '${myname}' on login?"
    select _autostart in yes no
    do
        case $_autostart in
            yes)
cat <<EOF> ${_desktopfile}
[Desktop Entry]
Name=@NAME@
Terminal=false
Type=Application
StartupNotify=false
Exec=${myname} start
EOF
                break
                ;;
            no)
                rm -fv "${_desktopfile}"
                break
                ;;
        esac
    done
}

case ${1:-status} in
    start)
        _start
        ;;
    stop)
        _stop
        ;;
    status)
        _status
        ;;
    restart)
        _stop ||:
        _start
        ;;
    settings)
        _settings
        ;;
    help)
        echo HELP
        ;;
    *)
        echo "ERROR '$1'"
        exit 1
        ;;
esac
