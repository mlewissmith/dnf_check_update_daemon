#!/bin/bash
set -ue

me="$(realpath $0)"
myname="$(basename ${me})"
mydir="$(dirname ${me})"
mypid="$$"

piddir="${XDG_RUNTIME_DIR}/@NAME@"
pidfile="${piddir}/${DISPLAY}"

updates_txt=${DNF_CHECK_UPDATE_DAEMON_TXT:-@updates_txt@}
__user_pystray_py="@pkglibexecdir@/user_pystray.py"
__user_notifyd_sh="@pkglibexecdir@/user_notifyd.sh"
declare -A pidof
pidof[pystray]=0
pidof[notifyd]=0


function _write_pidfile() {
    mkdir -p ${piddir}
    ps -p ${mypid} -opid= -oargs= > ${pidfile}
}

function _read_pidfile() {
    if
        [[ -e ${pidfile} ]]
    then
        local _pid _args
        read _pid _args < ${pidfile}
        if
            [[ $(ps -p ${_pid} -oargs=) == ${_args} ]]
        then
            echo ${_pid}
        else
            rm ${pidfile} >&2
        fi
    fi
}

function _status() {
    local _pid=$(_read_pidfile)
    if
        [[ -z ${_pid} ]]
    then
        echo "# '${myname}' is not running"
    else
        echo "# '${myname}' is running with pid [${_pid}]"
    fi
    if
        [[ -s "${updates_txt}" ]]
    then
        echo "# Updates available:"
        cat "${updates_txt}"
    fi
}

function _start() {
    if
        [[ -z $(_read_pidfile) ]]
    then
        _write_pidfile
        trap "rm ${pidfile}; pkill -P ${mypid}" EXIT

        $__user_notifyd_sh &
        pidof[notifyd]=$!

        $__user_pystray_py &
        pidof[pystray]=$!

        while true
        do
            for p in "${pidof[@]}"
            do
                kill -0 $p || exit 1
            done
            sleep 1
        done
    fi
}

function _stop() {
    local _pid=$(_read_pidfile)
    [[ -n ${_pid} ]] && kill ${_pid}
}

function _settings() {
    local _autostart=
    local xdg_autostart_dir="${XDG_CONFIG_HOME:-${HOME}/.config/autostart}"
    [[ -d "${xdg_autostart_dir}" ]] || return
    local _desktopfile="${xdg_autostart_dir}/@NAME@.desktop"
    echo "Autostart '${myname}' on login?"
    select _autostart in yes no
    do
        case $_autostart in
            yes)
cat <<EOF> ${_desktopfile}
[Desktop Entry]
Name=@NAME@
Terminal=false
Type=Application
StartupNotify=false
Exec=${myname} start
EOF
                break
                ;;
            no)
                rm -fv "${_desktopfile}"
                break
                ;;
        esac
    done
}

case ${1:-status} in
    start)
        _start
        ;;
    stop)
        _stop
        ;;
    status)
        _status
        ;;
    restart)
        _stop ||:
        exec $0 start
        ;;
    settings)
        _settings
        ;;
    help)
        echo "# @PACKAGE_NAME@ @PACKAGE_VERSION@"
        ;;
    *)
        echo "ERROR '$1'"
        exit 1
        ;;
esac
