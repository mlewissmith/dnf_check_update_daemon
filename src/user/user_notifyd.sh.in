#!/bin/bash
set -ue

__inotifywait=$(which inotifywait)
__notify_send=$(which notify-send)
updates_txt=${@PACKAGE_VARNAME@_TXT:-"@updates_txt@"}

while [[ -e ${updates_txt} ]]
do
    [[ -s ${updates_txt} ]] &&
        $__notify_send -u normal -t 5000 -i dialog-warning -- "Updates available:" "$(<${updates_txt})"
    $__inotifywait -qq -eclose_write ${updates_txt} &
    trap "kill $!" EXIT
    wait $!
done
