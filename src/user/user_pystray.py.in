## -*- python -*-
import pystray
from PIL import Image
import threading
import subprocess
import os
import atexit

updates_txt = os.getenv('@PACKAGE_VARNAME@_TXT', '@updates_txt@')
__user_notifyd = "@pkglibexecdir@/user_notifyd.sh"
__user_notifyd_pid = 0

icon_image = Image.new('RGB', (32,32), "cyan")

def kill_user_notifyd():
    global __user_notifyd_pid
    __user_notifyd_pid.terminate()

def user_notifyd():
    global __user_notifyd_pid
    __user_notifyd_pid = subprocess.Popen([__user_notifyd])
    atexit.register(kill_user_notifyd)
    __user_notifyd_pid.wait()

def menu_action(i, q):
    print(q)

def menu_action_stop(i,q):
    # __user_notifyd_pid.terminate()
    i.stop()

# default backend 'appindicator' does not support default action
# gtk backend supports default action (envvar PYSTRAY_BACKEND=gtk)
systray_icon = pystray.Icon(
    "NAME", icon_image, "TITLE",
    menu=pystray.Menu(
        pystray.MenuItem("start", menu_action),
        pystray.MenuItem("status", menu_action, default=True),
        pystray.MenuItem("settings", menu_action),
        pystray.MenuItem("stop", menu_action_stop),
    )
)

assert os.path.exists(updates_txt)
user_notifyd_thread = threading.Thread(target=user_notifyd, daemon=True)
user_notifyd_thread.start()
systray_icon.run()



