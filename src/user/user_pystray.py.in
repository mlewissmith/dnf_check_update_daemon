## -*- python -*-
import pystray
from PIL import Image
import threading
import subprocess
import os

# updates_txt = os.getenv('@PACKAGE_VARNAME@_TXT', '@updates_txt@')
updates_txt   = os.environ['@PACKAGE_VARNAME@_TXT']
__inotifywait = os.environ['__inotifywait']

alive = True
inotify_pid = 0

icon_image = Image.new('RGB', (32,32), "cyan")

def inotifywait():
    global inotify_pid
    global alive
    while alive:
        subprocess.run(['cat',updates_txt])
        inotify_pid = subprocess.Popen([__inotifywait,'-qq','-eclose_write',updates_txt])
        inotify_pid.wait()

def menu_action(i, q):
    print(q)
    print(inotify_pid)
    inotify_pid.terminate()

def menu_action_stop(i,q):
    global alive
    alive = False
    inotify_pid.terminate()
    i.stop()

# default backend 'appindicator' does not support default action
# gtk backend supports default action (envvar PYSTRAY_BACKEND=gtk)
systray_icon = pystray.Icon(
    "NAME", icon_image, "TITLE",
    menu=pystray.Menu(
        pystray.MenuItem("start", menu_action),
        pystray.MenuItem("status", menu_action, default=True),
        pystray.MenuItem("settings", menu_action),
        pystray.MenuItem("stop", menu_action_stop),
    )
)

assert os.path.exists(updates_txt)
watch_thread = threading.Thread(target=inotifywait, daemon=True)
watch_thread.start()
systray_icon.run()



