#!/bin/bash
set -ue

packages_db="@packages_db@"
updates_txt="@updates_txt@"

__dnf=$(which dnf)
__inotifywait=$(which inotifywait)

trap "rm ${updates_txt}" EXIT

function list_unique_updates() {
    ${__dnf} --quiet --cacheonly check-update     |
        awk '/^[[:space:]]/ {next}; NF {print $1}' |
        sort -u
}

while true
do
    list_unique_updates > "${updates_txt}"
    ${__inotifywait} -qq -e close_write "${packages_db}"
done
