#!/bin/bash
set -ue

packages_db="@packages_db@"
updates_txt="@updates_txt@"

trap "rm ${updates_txt}" EXIT

function list_unique_updates() {
    dnf --quiet --cacheonly check-update | awk 'NF{print $1}' | sort -u
}

while true
do
    list_unique_updates > "${updates_txt}"
    inotifywait -qq -e close_write "${packages_db}"
done
